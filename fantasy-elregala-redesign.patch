+/* Palette: painted five-a-side court. Court blue, bib yellow, turf green, chalk. */
+:root{
+  --bg:#eef1f6;--card:#ffffff;--ink:#0f1a3a;--mu:#5d6785;--line:#d6dcea;
+  --court:#1e3fa8;--court-2:#16307f;--bib:#ffd23f;--bib-ink:#2a2200;
+  --turf:#17794b;--turf-2:#0f5c37;--ok:#157a47;--bad:#c4321f;--tint:#e6ecfb;
+  --r-lg:20px;--r-md:14px;--r-sm:10px;
+  --shadow:0 1px 2px rgba(15,26,58,.06),0 8px 24px -12px rgba(15,26,58,.18);
+  --display:"Bricolage Grotesque","Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
+  --body:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
+  box-sizing:border-box;
+}
+@media (prefers-color-scheme:dark){:root{
+  --bg:#0b1126;--card:#131b36;--ink:#e8ecf8;--mu:#97a1c0;--line:#27315a;
+  --court:#7f9cff;--court-2:#5f7ff0;--tint:#1a2550;--ok:#4cc38a;--bad:#ff7b66;--shadow:0 1px 2px rgba(0,0,0,.4),0 10px 28px -14px rgba(0,0,0,.6)}}
+*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
+html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
+body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.45 var(--body);-webkit-font-smoothing:antialiased;min-height:100vh}
+h1,h2,h3{font-family:var(--display);margin:0;line-height:1.05;letter-spacing:-.02em}
+b,strong{font-weight:700}
+a{color:var(--court)}
+:focus-visible{outline:3px solid var(--bib);outline-offset:2px;border-radius:8px}
+
+/* controls */
+button,select,input{font:inherit;color:var(--ink)}
+input,select{width:100%;background:var(--card);border:1.5px solid var(--line);border-radius:var(--r-sm);padding:12px 14px;min-height:46px;transition:border-color .15s,box-shadow .15s}
+input::placeholder{font-weight:500;color:var(--mu);opacity:.7}
+input:focus,select:focus{outline:none;border-color:var(--court);box-shadow:0 0 0 4px color-mix(in srgb,var(--court) 20%,transparent)}
+input[type=checkbox]{width:22px;height:22px;min-height:0;accent-color:var(--court)}
+button{cursor:pointer;border:1.5px solid var(--line);background:var(--card);border-radius:999px;padding:11px 20px;min-height:46px;font-weight:700;transition:transform .12s,background .15s,border-color .15s,opacity .15s}
+button:active:not(:disabled){transform:scale(.97)}
+button:disabled{opacity:.45;cursor:not-allowed}
+button.on,.btn-primary{background:var(--court);border-color:var(--court);color:#fff}
+@media (prefers-color-scheme:dark){button.on,.btn-primary{color:#0b1126}}
+button.bib{background:var(--bib);border-color:var(--bib);color:var(--bib-ink)}
+button.ghost{background:transparent;border-color:transparent;color:var(--mu);padding:8px 12px;min-height:40px}
+button.small{min-height:38px;padding:7px 14px;font-size:14px}
+button.full{width:100%}
+label{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;color:var(--mu)}
+label small{font-weight:500;color:var(--mu)}
+.f{display:grid;gap:14px;margin-top:16px}
+.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:12px}
+.mu{color:var(--mu);font-size:14px}.ok{color:var(--ok);font-weight:700}.bad{color:var(--bad);font-weight:700}
+.row{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
+.card{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:18px;margin:14px 0;box-shadow:var(--shadow)}
+.card h2{font-size:22px;margin-bottom:4px}
+.scroll{overflow-x:auto}
+table{border-collapse:collapse;width:100%}
+th,td{padding:11px 8px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
+th{color:var(--mu);font-size:13px;font-weight:600}
+tr:last-child td{border-bottom:0}
+.chip{display:inline-flex;align-items:center;gap:6px;padding:5px 12px;border-radius:999px;font-size:13px;font-weight:700;background:var(--tint);color:var(--court)}
+.chip.open{background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok)}
+.chip.locked{background:color-mix(in srgb,var(--bad) 14%,transparent);color:var(--bad)}
+
+/* shell */
+#progress{position:fixed;inset:0 0 auto 0;height:3px;z-index:30;background:var(--bib);transform:scaleX(0);transform-origin:left;opacity:0;pointer-events:none}
+body[data-busy] #progress{opacity:1;animation:prog 1.2s ease-in-out infinite}
+body[data-busy] button,body[data-busy] .league{pointer-events:none;opacity:.7}
+@keyframes prog{0%{transform:scaleX(0)}60%{transform:scaleX(.8)}100%{transform:scaleX(1);opacity:0}}
+.topbar{background:var(--court);color:#fff;padding:calc(18px + env(safe-area-inset-top,0px)) 20px 22px;border-radius:0 0 28px 28px}
+@media (prefers-color-scheme:dark){.topbar{background:#16214a}}
+.topbar-in{max-width:900px;margin:auto;display:flex;justify-content:space-between;align-items:flex-end;gap:12px}
+.topbar h1{font-size:30px;color:#fff;overflow-wrap:anywhere}
+.topbar .sub{opacity:.85;font-size:14px;margin-top:6px}
+.topbar button.ghost{color:#fff;border:1.5px solid rgba(255,255,255,.4);min-height:38px;padding:6px 14px;font-size:14px;flex:none}
+main{padding:6px 16px calc(120px + env(safe-area-inset-bottom,0px));max-width:900px;margin:auto}
+nav{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:20;display:flex;gap:4px;padding:6px;background:var(--card);border:1px solid var(--line);border-radius:999px;box-shadow:0 12px 32px -10px rgba(15,26,58,.35);max-width:calc(100% - 24px);overflow-x:auto}
+nav:empty{display:none}
+nav button{border:0;background:transparent;color:var(--mu);padding:10px 14px;font-size:15px;min-height:44px;white-space:nowrap}
+nav button.on{background:var(--court);color:#fff}
+@media (prefers-color-scheme:dark){nav button.on{color:#0b1126}}
+.view-enter{animation:viewIn .22s ease-out}
+@keyframes viewIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
+#toast{position:fixed;left:50%;bottom:calc(88px + env(safe-area-inset-bottom,0px));transform:translate(-50%,16px);background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:14px;z-index:40;max-width:90%;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
+#toast.show{opacity:1;transform:translate(-50%,0)}
+#toast.err{background:var(--bad);color:#fff}
+
+/* auth screens */
+.auth{max-width:460px;margin:auto;padding:calc(16px + env(safe-area-inset-top,0px)) 16px calc(32px + env(safe-area-inset-bottom,0px))}
+.court{position:relative;border-radius:var(--r-lg);overflow:hidden;background:var(--court);aspect-ratio:4/3;box-shadow:var(--shadow)}
+@media (prefers-color-scheme:dark){.court{background:#16214a}}
+.court svg{position:absolute;inset:0;width:100%;height:100%}
+.court .chalk{fill:none;stroke:rgba(255,255,255,.85);stroke-width:1.6;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1.1s .1s ease-out forwards}
+.court .dot{fill:var(--bib)}
+@keyframes draw{to{stroke-dashoffset:0}}
+.court-title{position:absolute;left:20px;top:18px;right:20px;color:#fff}
+.court-title h1{font-size:clamp(30px,9vw,44px);color:#fff}
+.panel{background:var(--card);border:1px solid var(--line);border-radius:var(--r-lg);padding:22px;margin-top:14px;box-shadow:var(--shadow)}
+.panel h2{font-size:26px}
+.lede{margin:8px 0 0;color:var(--mu)}
+.hint{font-size:13px;color:var(--mu);font-weight:500}
+
+/* league picker */
+.leagues{display:grid;gap:10px;margin-top:16px}
+.league{display:flex;align-items:center;justify-content:space-between;gap:14px;text-align:left;width:100%;border-radius:var(--r-md);padding:16px;border:1.5px solid var(--line);background:var(--card);min-height:72px}
+.league:hover{border-color:var(--court);background:var(--tint)}
+.league .nm{font-family:var(--display);font-weight:800;font-size:19px;line-height:1.15;overflow-wrap:anywhere}
+.league .meta{font-size:13px;color:var(--mu);font-weight:500;margin-top:3px}
+.league .go{flex:none;background:var(--bib);color:var(--bib-ink);border-radius:999px;padding:8px 16px;font-weight:700;font-size:14px}
+.skel{height:72px;border-radius:var(--r-md);background:linear-gradient(90deg,var(--tint),var(--line),var(--tint));background-size:200% 100%;animation:sh 1.2s linear infinite}
+@keyframes sh{to{background-position:-200% 0}}
+.empty{padding:18px;border:1.5px dashed var(--line);border-radius:var(--r-md);color:var(--mu);text-align:center}
+details.more{margin-top:14px;border-top:1px solid var(--line);padding-top:6px}
+details.more summary{cursor:pointer;font-weight:700;padding:12px 0;list-style:none;display:flex;justify-content:space-between;align-items:center}
+details.more summary::-webkit-details-marker{display:none}
+details.more summary::after{content:"+";font-size:22px;color:var(--court);transition:transform .2s}
+details.more[open] summary::after{transform:rotate(45deg)}
+
+/* budget meter */
+.meter{height:12px;border-radius:999px;background:var(--tint);overflow:hidden}
+.meter i{display:block;height:100%;border-radius:999px;background:var(--court);transition:width .35s cubic-bezier(.3,.8,.3,1),background .2s}
+.meter.over i{background:var(--bad)}
+.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:14px}
+.stat{border:1px solid var(--line);border-radius:var(--r-md);padding:10px 12px}
+.stat span{display:block;font-size:13px;color:var(--mu)}
+.stat b{font-family:var(--display);font-size:20px}
+
+/* pitch */
+.pitch{position:relative;max-width:460px;margin:16px auto;aspect-ratio:3/4;border-radius:var(--r-lg);overflow:hidden;
+  background:repeating-linear-gradient(180deg,var(--turf) 0 12.5%,var(--turf-2) 12.5% 25%);box-shadow:inset 0 0 0 4px rgba(255,255,255,.12)}
+.pitch svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
+.pitch svg *{fill:none;stroke:rgba(255,255,255,.55);stroke-width:.7}
+.formation{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;padding:6% 6% 5%}
+.line{display:flex;justify-content:space-evenly;align-items:center}
+.slot{--sh:clamp(44px,13vw,58px);position:relative;display:flex;flex-direction:column;align-items:center;gap:3px;background:transparent;border:0;padding:0;min-height:0;color:#fff;border-radius:14px;width:30%}
+.slot .shirt{width:var(--sh);aspect-ratio:1;border-radius:50%;display:grid;place-items:center;font-family:var(--display);font-weight:800;font-size:16px;
+  border:2.5px dashed rgba(255,255,255,.7);color:rgba(255,255,255,.9);background:rgba(255,255,255,.08);transition:transform .2s cubic-bezier(.3,1.4,.5,1),background .2s}
+.slot:hover .shirt{transform:scale(1.06)}
+.slot.filled .shirt{background:var(--bib);border:2.5px solid #fff;color:var(--bib-ink);box-shadow:0 6px 14px rgba(0,0,0,.3);animation:pop .28s cubic-bezier(.3,1.5,.5,1)}
+@keyframes pop{from{transform:scale(.6)}to{transform:scale(1)}}
+.slot .tag{font-size:12px;font-weight:700;line-height:1.15;padding:4px 10px;border-radius:999px;background:rgba(7,32,19,.62);max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.slot .price{font-size:11px;opacity:.9;font-weight:700;line-height:1}
+.cap{position:absolute;top:-4px;right:calc(50% - var(--sh)/2 - 8px);width:22px;height:22px;border-radius:50%;background:#fff;color:var(--court-2);display:grid;place-items:center;font-size:12px;font-weight:800;box-shadow:0 2px 6px rgba(0,0,0,.3)}
+
+/* player pool */
+.pool{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px}
+.pool h3{font-size:17px;margin-bottom:10px}
+.pcards{display:grid;gap:8px}
+.pc{display:flex;justify-content:space-between;align-items:center;gap:10px;text-align:left;width:100%;border-radius:var(--r-md);padding:12px 14px;min-height:56px}
+.pc:hover{border-color:var(--court)}
+.pc.selected{background:var(--tint);border-color:var(--court)}
+.pc .nm{font-weight:700;overflow-wrap:anywhere}
+.pc .pr{font-family:var(--display);font-weight:800;font-size:17px;flex:none}
+.pc .st{font-size:12px;font-weight:700;color:var(--court)}
+.empty-bank{font-size:13px;color:var(--mu);padding:12px;border:1.5px dashed var(--line);border-radius:var(--r-md)}
+
+/* leaderboard */
+.code{display:inline-block;font-family:var(--display);font-weight:800;font-size:30px;letter-spacing:.14em;padding:8px 16px;border:2px dashed var(--court);border-radius:14px;color:var(--court);margin:12px 0 4px}
+.rank{display:grid;grid-template-columns:44px 1fr auto;gap:12px;align-items:center;padding:14px 4px;border-bottom:1px solid var(--line)}
+.rank:last-child{border-bottom:0}
+.rank .n{font-family:var(--display);font-weight:800;font-size:22px;text-align:center;width:40px;height:40px;line-height:40px;border-radius:50%;background:var(--tint);color:var(--court)}
+.rank.first .n{background:var(--bib);color:var(--bib-ink)}
+.rank .who{min-width:0}
